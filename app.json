{
  "expo": {
    "name": "Print Laser Stitch",
    "slug": "print-laser-stitch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "printlaserstitchmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.printlaserstitch.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.printlaserstitch.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0c10",
          "image": "./assets/images/icon.png",
          "imageWidth": 260
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Print Laser Stitch needs access to your photos so you can upload artwork to print.",
          "cameraPermission": "Print Laser Stitch needs access to your camera so you can photograph artwork to print."
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cbb2605-0640-44dc-b053-bec9f1429cef"
      }
    },
    "owner": "anthonyvalcours-team"
  }
}
